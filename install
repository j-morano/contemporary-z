#!/usr/bin/env python3

import os
from urllib import request
from pathlib import Path
from os.path import expandvars
import shutil
import re


## Options
# Path to install contemporary-z to
path = '$HOME/.local/bin/'
# Shell to install contemporary-z for
shell = os.getenv('SHELL')
# Install from source
source = False
# Update existing installation
update = False
# Repository files (used when installing from source)
src_path = '.'
# Valid shells to install contemporary-z for
valid_shells = ['bash', 'zsh', 'fish']

REPOSITORY = 'https://github.com/j-morano/contemporary-z'
RAW_FILES = 'https://raw.githubusercontent.com/j-morano/contemporary-z/main'


def is_valid_shell(shell):
    return any(valid_shell in shell for valid_shell in valid_shells)


def fetch(name):
    """Contents of a file of the repository: the local copy when installing
    from source, otherwise the one from GitHub."""
    local_path = os.path.join(src_path, name)
    if source and os.path.exists(local_path):
        with open(local_path) as fp:
            return fp.read()
    with request.urlopen(f'{RAW_FILES}/{name}') as response:
        return response.read().decode()


def write_file(file_path, contents):
    Path(file_path).parent.mkdir(parents=True, exist_ok=True)
    with open(file_path, 'w') as fp:
        fp.write(contents)


def setup_fish():
    print('Setting up cz for fish shell.')
    # The function file is ours, so it is always replaced (also on updates)
    z_fish_func_path = expandvars('$HOME/.config/fish/functions/z.fish')
    print(f' - Writing the z function to {z_fish_func_path}.')
    write_file(z_fish_func_path, fetch('z.fish'))


def setup_posix(shell_name):
    rc_path = expandvars(f'$HOME/.{shell_name}rc')
    print(f'Setting up cz for {shell_name} ({rc_path}).')
    rc_contents = ''
    if os.path.exists(rc_path):
        with open(rc_path) as fp:
            rc_contents = fp.read()

    if re.search(r'^\s*(function\s+)?z\s*\(\s*\)', rc_contents, re.MULTILINE):
        print(
            f'Warning: a function `z` already exists in {rc_path}, so it was not',
            '  modified. To update it, replace it with the contents of z.sh:',
            f'  {RAW_FILES}/z.sh',
            sep='\n'
        )
    else:
        print(' - Adding the z function.')
        with open(rc_path, 'a') as fp:
            fp.write('\n' + fetch('z.sh'))


# Offer all options and ask user to select one
print('''\
Welcome to the contemporary-z installer!
Please select an option:
  1. Install from binary (recommended).
  2. Install from source.
  3. Update existing installation.
  4. Exit.\
''')

while True:
    try:
        option = input('Option: ')
        if option == '1':
            print('=> Installing from binary.')
            source = False
            break
        elif option == '2':
            print('=> Installing from source.')
            source = True
            break
        elif option == '3':
            print('=> Updating existing installation.')
            update = True
            break
        elif option == '4' or option == '':
            print('=> Exiting.')
            exit(0)
        else:
            print('Invalid option.')
    except ValueError:
        print('Invalid option.')

path = expandvars(path)

if source:
    if not os.path.exists('Cargo.toml'):
        print('Cloning repository.')
        os.system(f"git clone {REPOSITORY}.git")
        src_path = 'contemporary-z'
    print('Installing using Cargo.')
    os.system(f"$HOME/.cargo/bin/cargo install --path {src_path}")
else:
    print('Downloading binary.')
    request.urlretrieve(f"{REPOSITORY}/releases/latest/download/cz", "cz")
    print('Making binary executable.')
    st = os.stat('cz')
    os.chmod('cz', st.st_mode | 0o0111)
    print(
        'Please select the installation path, or press enter to use the',
        '  default ({}).'.format(path),
        sep='\n'
    )
    while True:
        try:
            new_path = input('Path: ')
            if new_path == '':
                break
            elif os.path.exists(new_path):
                path = new_path
                break
            else:
                print('Invalid path.')
        except ValueError:
            print('Invalid path.')
    if os.path.exists(os.path.join(path, 'cz')):
        print('Removing existing binary.')
        os.remove(os.path.join(path, 'cz'))
    print('Adding new binary.')
    if not os.path.exists(path):
        print(f'The path "{path}" does not exist. Do you want to create it?')
        print('Warning: if you choose not to create the path, the installation will be aborted.')
        while True:
            create_path = input('Create path? [y/n]: ')
            if create_path == 'y':
                print(' - Creating path.')
                os.makedirs(path)
                break
            else:
                print('Installation aborted.')
                exit(1)
    shutil.move('cz', path)

# The shell function is also set up on updates, since it may have changed
if shell is None or not is_valid_shell(shell):
    print(
        'Warning: could not detect shell.',
        'Please specify the shell you want to install contemporary-z for.',
        'Options: {}'.format(', '.join(valid_shells)),
        sep='\n'
    )
    while True:
        try:
            shell = input('Shell: ')
            if not is_valid_shell(shell):
                print('Invalid shell.')
            else:
                break
        except ValueError:
            print('Invalid shell.')

if 'fish' in shell:
    setup_fish()
elif 'zsh' in shell:
    setup_posix('zsh')
elif 'bash' in shell:
    setup_posix('bash')

print('''\
Done! Please restart your shell.
Then, you can check if contemporary-z is correctly installed by running:
$ z --version
''')
